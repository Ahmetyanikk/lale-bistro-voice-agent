# --- Backend (read by app/config.py) ---
TOOL_SECRET=changeme-local-dev-secret
DATABASE_URL=sqlite:///./lale_bistro.db

# --- OloVoice integration (not read by app code yet — Phase 2 only prepares
# these; nothing in this repo calls the OloVoice API yet) ---

# Used only when OUR code calls the OloVoice API (not implemented yet).
# Never the same value as TOOL_SECRET.
OLOVOICE_API_KEY=changeme-olovoice-api-key

# Public HTTPS base URL of this backend, used to fill in tool webhookUrls in
# the OloVoice dashboard and by scripts/smoke_test.py.
BASE_URL=https://your-public-domain.example.com

# From the OloVoice dashboard once the assistant/number are created.
OLOVOICE_ASSISTANT_ID=changeme-assistant-id
OLOVOICE_PHONE_NUMBER_ID=changeme-phone-number-id
OLOVOICE_ORGANIZATION_ID=changeme-org-id
